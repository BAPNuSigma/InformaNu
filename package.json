  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
