{
  "name": "informanu-vercel",
  "version": "1.0.0",
  "private": true,
  "description": "Vercel-hosted Next.js version of the InformaNu BAP-NuSigma Q&A chatbot",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
